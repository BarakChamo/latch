{
  "name": "latch-workspace",
  "version": "0.1.3",
  "private": true,
  "packageManager": "npm@11.19.1",
  "exports": {
    ".": "./plugins/opencode/index.js",
    "./server": "./plugins/opencode/index.js"
  },
  "pi": { "extensions": ["./plugins/pi/index.ts"] },
  "files": [
    "plugins/extension-hook.mjs",
    "plugins/extension-launch.sh",
    "plugins/opencode",
    "plugins/pi"
  ],
  "scripts": {
    "build": "turbo run build:rust",
    "check": "turbo run format:check lint:rust test:rust && npm run test:schema",
    "fmt": "cargo fmt --all",
    "package:release": "node distribution/package-release.mjs",
    "test:plugin-installer": "node --test distribution/smoke-plugin-installer.mjs",
    "test:release": "node distribution/smoke-release.mjs",
    "test:live": "node distribution/smoke-harnesses.mjs",
    "test:schema": "node --test distribution/check-schema.mjs",
    "test:extensions": "node distribution/smoke-extensions.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "turbo": "2.11.13"
  },
  "workspaces": [
    "crates/latch"
  ]
}
