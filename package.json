{
  "name": "@barakchamo/latch-agent-plugins",
  "version": "0.1.4",
  "description": "Run Latch checks automatically in Pi and OpenCode.",
  "license": "UNLICENSED",
  "homepage": "https://barakchamo.github.io/latch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarakChamo/latch.git"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "latch"
  ],
  "type": "module",
  "exports": {
    ".": "./plugins/opencode/index.js",
    "./server": "./plugins/opencode/index.js"
  },
  "pi": {
    "extensions": [
      "./plugins/pi/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "plugins/extension-hook.mjs",
    "plugins/pi",
    "plugins/opencode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
