{
  "name": "latch",
  "version": "0.1.3",
  "description": "Run project validation at the end of Kimi Code turns.",
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "command": "./plugins/extension-launch.sh hook kimi",
      "timeout": 120
    },
    {
      "event": "Stop",
      "command": "./plugins/extension-launch.sh hook kimi",
      "timeout": 120
    }
  ],
  "mcpServers": {
    "latch": {
      "command": "./plugins/extension-launch.sh",
      "args": [
        "mcp",
        "--require-project-directory"
      ]
    }
  }
}
