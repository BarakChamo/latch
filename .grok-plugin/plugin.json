{
  "name": "latch",
  "version": "0.1.3",
  "description": "Run project checks as Grok Build edits files and finishes turns.",
  "hooks": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$GROK_PLUGIN_ROOT/plugins/extension-launch.sh\" hook grok",
              "timeout": 120
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$GROK_PLUGIN_ROOT/plugins/extension-launch.sh\" hook grok",
              "timeout": 120
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$GROK_PLUGIN_ROOT/plugins/extension-launch.sh\" hook grok",
              "timeout": 120
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$GROK_PLUGIN_ROOT/plugins/extension-launch.sh\" hook grok",
              "timeout": 120
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$GROK_PLUGIN_ROOT/plugins/extension-launch.sh\" hook grok",
              "timeout": 120
            }
          ]
        }
      ]
    }
  },
  "mcpServers": {
    "latch": {
      "command": "/bin/sh",
      "args": [
        "${GROK_PLUGIN_ROOT}/plugins/extension-launch.sh",
        "mcp",
        "--require-project-directory"
      ]
    }
  }
}
